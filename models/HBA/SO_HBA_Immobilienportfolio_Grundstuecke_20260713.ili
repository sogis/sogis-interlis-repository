INTERLIS 2.4;

/** !!------------------------------------------------------------------------------
 * !! Version    | wer | Änderung
 * !!------------------------------------------------------------------------------
 * !! 2026-07-13 | pb | Initiale Erstellung
 * !!==============================================================================
 */
!!@ shortDescription="Importmodell für die Grundstücke aus dem Immobilienportfolio des Hochbauamtes Kanton Solothurn"
!!@ title="Grundstücke des Kanton Solothurns (Immobilienportfolio)"
!!@ technicalContact=agi@bd.so.ch
MODEL SO_HBA_Immobilienportfolio_Grundstuecke_20260713 (de)
  AT "https://geo.so.ch/models/HBA"
  VERSION "2026-07-13"
  =

  DOMAIN
    Vermoegensart = (
      AM,
      SV,
      VV,
      FV
    );
    Prioritaetsstufe = (
      A,
      B,
      C
    );

  TOPIC Grundstuecke =

    /** Grundstückattribute, welche bezüglich ihrer Kardinalität fix sind
     */
    CLASS Grundstueckebasis (ABSTRACT) =
      /** Eidgenössischer Grundstücksidentifikator
       */
      egrid : MANDATORY TEXT*14;
      /** Besteht Eigenbedarf?
       */
      eigenbedarf : TEXT*50;
      /** Fachliche Verantwortung für das Grundstück
       */
      fach_verantwortung : TEXT*100;
      /** Besteht ein Baurecht für Dritte?
       */
      baurecht : TEXT*50;
      /** Veräusserungsjahr
       */
      jahr_veraeussert : 1900 .. 2100;
      UNIQUE egrid;
    END Grundstueckebasis;

    /** Grundstück-Importklasse
     */
    CLASS CSV_Import EXTENDS SO_HBA_Immobilienportfolio_Grundstuecke_20260713.Grundstuecke.Grundstueckebasis =
      /** HBA-interne, eindeutige Grundstücknummer (SAP-ID)
       */
      id_gr : TEXT*20;
      /** HBA-interne, eindeutiger Grundstücksschlüssel
       */
      we : TEXT*4;
      /** Vermögensart
       */
      vermoegensart : SO_HBA_Immobilienportfolio_Grundstuecke_20260713.Vermoegensart;
      /** Priorität im Kontext der Immobilienstrategie
       */
      prio : SO_HBA_Immobilienportfolio_Grundstuecke_20260713.Prioritaetsstufe;
    END CSV_Import;

    /** Wenn entweder das Attribut baurecht den Wert 'Baurecht' aufweist oder das Attribut jahr_veraeussert nicht NULL ist, weisen die restlichen Attribute oft keine vollständigen Daten auf.
     * Um beim Datenimport einen möglichst vollständigen Datensatz sicherzustellen, sind in dieser KLasse die Attribute mandatory, welche immer vorhanden sein sollten, sofern die zwei vorhin genannten Bedigungen nicht bestehen.
     * Vor der Publikation, sollten die betroffenen Daten zur Prüfung der Vollständigkeit in diese Klasse abgefüllt werden.
     */
    CLASS GrundstueckeMandatory EXTENDS SO_HBA_Immobilienportfolio_Grundstuecke_20260713.Grundstuecke.Grundstueckebasis =
      /** HBA-interne, eindeutige Grundstücknummer (SAP-ID)
       */
      id_gr : MANDATORY TEXT*20;
      /** HBA-interne, eindeutiger Grundstücksschlüssel
       */
      we : MANDATORY TEXT*4;
      /** Vermögensart
       */
      vermoegensart : MANDATORY SO_HBA_Immobilienportfolio_Grundstuecke_20260713.Vermoegensart;
      /** Priorität im Kontext der Immobilienstrategie
       */
      prio : MANDATORY SO_HBA_Immobilienportfolio_Grundstuecke_20260713.Prioritaetsstufe;
    END GrundstueckeMandatory;

  END Grundstuecke;

END SO_HBA_Immobilienportfolio_Grundstuecke_20260713.
