INTERLIS 2.3;

/** !!------------------------------------------------------------------------------
 * !! Version    | wer | Änderung
 * !!------------------------------------------------------------------------------
 * !! 2026-07-13 | pb | Initiale Erstellung
 * !!==============================================================================
 */
!!@ shortDescription="Importmodell für die Gebäude aus dem Immobilienportfolio des Hochbauamtes Kanton Solothurn"
!!@ title="Gebäude des Kanton Solothurns (Immobilienportfolio)"
!!@ technicalContact=agi@bd.so.ch
MODEL SO_HBA_Immobilienportfolio_Gebaeude_20260713 (de)
  AT "https://geo.so.ch/models/HBA"
  VERSION "2026-07-13"
  =

  DOMAIN
    Vermoegensart = (
      AM,
      SV,
      VV,
      FV
    );
    Prioritaetsstufe = (
      A,
      B,
      C
    );
    Nutzungsart = (
      /** HPSZ, BBZ, Kantonsschule, FHNW
       */
      Bildung,
      /** Spitäler
       */
      Gesundheit,
      Lager_Archiv,
      /** Polizei und Justizvollzug
       */
      Sicherheit,
      Sonstiges,
      Stiftung,
      Verwaltung,
      Landwirtschaft
    );

  TOPIC Gebaeude =

    /** Gebäudeattribute, welche bezüglich der Eindeutigkeit immer vorkommen
     */
    CLASS GebaeudeBasis (ABSTRACT) =
      /** Eidgenössischer Gebäudeidentifikator
       */
      egid : MANDATORY 1 .. 999999999;
      /** HBA-interne, eindeutige Gebäudenummer (SAP-ID)
       */
      id_ge : MANDATORY TEXT*20;
      /** Gebäudenutzungsart
       */
      nutzung : MANDATORY SO_HBA_Immobilienportfolio_Gebaeude_20260713.Nutzungsart;
      /** Gebäudebezeichnung
       */
      Gebaeude_Bez : MANDATORY TEXT*100;
      /** Eigenbedarf des Kantons
       */
      eigenbedarf : TEXT*50;
      /** Wird das Gebäude vom Kanton gemietet? (AM = Anmiete)
       */
      anmiete : TEXT*10;
      /** Ist die Liegenschaft an Dritte vermietet?
       */
      vermietet : TEXT*50;
      /** Immoinfo-Link
       */
      link : INTERLIS.URI;
      /** Verantwortliche Person für das Gebäude mit E-Mail-Link
       */
      verantwortung_geb : INTERLIS.URI;
      /** Verantwortliche Person für die Hauswartung mit E-Mail-Link
       */
      verantwortung_hw : INTERLIS.URI;
      UNIQUE egid;
    END GebaeudeBasis;

    /** Gebäude-Importklasse
     */
    CLASS CSV_Import EXTENDS SO_HBA_Immobilienportfolio_Gebaeude_20260713.Gebaeude.GebaeudeBasis =
      /** Vermögensart
       */
      vermoegensart : SO_HBA_Immobilienportfolio_Gebaeude_20260713.Vermoegensart;
      /** Priorität im Kontext der Immobilienstrategie
       */
      prio : SO_HBA_Immobilienportfolio_Gebaeude_20260713.Prioritaetsstufe;
      /** Bauperiode des Gebäudes
       */
      baujahr_gruppe : TEXT*50;
    END CSV_Import;

    /** Abhängig von den Werten bei den Attributen anmiete (Wert 'AM') und vermietet (Wert 'vermietet'), weisen andere Attribute nur NULL-Werte auf.
     *  Diese Klasse dient dazu eine Kontrolle der "anderen" Attribute durchzuführen.
     *  Dafür müssen diese Attribute mit "Mandatory" versehen und bei der Umverteilung die vorhin genannten Werte rausgefiltert werden.
     */
    CLASS GebaeudeMandatory EXTENDS SO_HBA_Immobilienportfolio_Gebaeude_20260713.Gebaeude.GebaeudeBasis =
      /** Vermögensart
       */
      vermoegensart : MANDATORY SO_HBA_Immobilienportfolio_Gebaeude_20260713.Vermoegensart;
      /** Priorität im Kontext der Immobilienstrategie
       */
      prio : MANDATORY SO_HBA_Immobilienportfolio_Gebaeude_20260713.Prioritaetsstufe;
      /** Bauperiode des Gebäudes
       */
      baujahr_gruppe : MANDATORY TEXT*50;
    END GebaeudeMandatory;

    /** Abhängig von den Werten bei den Attributen anmiete (Wert 'AM') und vermietet (Wert 'vermietet'), weisen andere Attribute nur NULL-Werte auf.
     *  Die Attribute mit den vorhin genannten Werten werden in diese Klasse abgefüllt.
     */
    CLASS GebaeudeOptional EXTENDS SO_HBA_Immobilienportfolio_Gebaeude_20260713.Gebaeude.GebaeudeBasis =
      /** Vermögensart
       */
      vermoegensart : SO_HBA_Immobilienportfolio_Gebaeude_20260713.Vermoegensart;
      /** Priorität im Kontext der Immobilienstrategie
       */
      prio : SO_HBA_Immobilienportfolio_Gebaeude_20260713.Prioritaetsstufe;
      /** Bauperiode des Gebäudes
       */
      baujahr_gruppe : TEXT*50;
    END GebaeudeOptional;

  END Gebaeude;

END SO_HBA_Immobilienportfolio_Gebaeude_20260713.
