INTERLIS 2.4;

/** Modell SO_AMB_Verkehrsfuehrung_Unfall_KKW_20261015
 * !!  Informationen zur Darstellung der Kartenobjekte im Verkehrskonzept für die beiden Ebenen 
 * !!  "Hauptrettungsachsen" (Konzept Kapitel 11.1.3) und "Sperrstellen" (Konzept Kapitel 11.1.4)
 * !!------------------------------------------------------------------------------
 * !! Version    | wer       | Änderung
 * !!------------------------------------------------------------------------------
 * !! 2026-10-15 | bjsvwcur  | Erstfassung
 * !!==============================================================================
 */
!!@ shortDescription="Vorlage-Modell zum Kopieren der im AGI häufig genutzten Modell-Elemente"
!!@ title=Modellvorlage
!!@ technicalContact=agi@bd.so.ch
MODEL SO_AMB_Verkehrsfuehrung_Unfall_KKW_20261015 (de)
  AT "https://geo.so.ch/models/AMB"
  VERSION "2026-10-15"
  =
  IMPORTS GeometryCHLV95_V2;

  TOPIC Verkehrsfuehrung_Unfall_KKW =
    OID AS INTERLIS.UUIDOID;

    CLASS Hauptrettungsachse =
      Rettungsachse : MANDATORY GeometryCHLV95_V2.LineWithoutArcs;
      Beschreibung : MANDATORY TEXT*100; 
    END Hauptrettungsachse;

    CLASS VP_Freihaltung_RA =
      Verkehrsposten : MANDATORY GeometryCHLV95_V2.Coord2;
      Name : MANDATORY TEXT*10;
    END VP_Freihaltung_RA;

    CLASS Sperrstellen =
      Signalstandort : MANDATORY GeometryCHLV95_V2.Coord2;
      Nummer : MANDATORY 0.0 .. 99.9;
      Beschreibung : MANDATORY TEXT*100;
      Dokument : URI;
    END Sperrstellen;
  
  END Verkehrsfuehrung_Unfall_KKW;

END SO_AMB_Verkehrsfuehrung_Unfall_KKW_20261015.