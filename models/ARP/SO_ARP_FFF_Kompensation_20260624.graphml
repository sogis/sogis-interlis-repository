<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:y="http://www.yworks.com/xml/graphml"
         xmlns:yed="http://www.yworks.com/xml/yed/3"
         xmlns:java="http://www.yworks.com/xml/yfiles-common/1.0/java"
         xmlns:sys="http://www.yworks.com/xml/yfiles-common/markup/primitives/2"
         xmlns:x="http://www.yworks.com/xml/yfiles-common/markup/2.0">
  <key id="d0" for="node" yfiles.type="nodegraphics"/>
  <key id="d1" for="edge" yfiles.type="edgegraphics"/>
  <graph edgedefault="directed" id="G">
    <node id="n0" yfiles.foldertype="group">
      <data key="d0">
        <y:GroupNode>
          <y:Geometry height="400.0" width="400.0" x="0.0" y="0.0"/>
          <y:Fill color="#FFFFFF" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="13" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" modelName="internal" modelPosition="t" visible="true">Kompensation</y:NodeLabel>
          <y:State closed="false"/>
          <y:Insets bottom="15" left="15" right="15" top="45"/>
        </y:GroupNode>
      </data>
      <graph edgedefault="directed" id="n0:">
        <node id="n1">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#04b889" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Beanspruchungsflaeche</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">Beanspruchungsflaeche_Bemerkungen[0..1] : String&#10;Bezeichnung[0..1] : String&#10;Flaeche[0..1] : Numeric&#10;Geometrie[1] : AreaWithOverlaps2mm</y:AttributeLabel>
                <y:MethodLabel textColor="#000000"></y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
        <node id="n2">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#04b889" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Gesuchsteller</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">Adresse[0..1] : String&#10;Firma[1] : String&#10;Kontaktperson[0..1] : String&#10;Mail[0..1] : String&#10;Telefon[0..1] : String&#10;UID[1] : String</y:AttributeLabel>
                <y:MethodLabel textColor="#000000">Constraint1()</y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
        <node id="n3">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#04b889" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Kompensationsflaeche</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">Bezeichnung[0..1] : String&#10;Flaeche[0..1] : Numeric&#10;Geometrie[1] : AreaWithOverlaps2mm&#10;Kompensation_Bemerkungen[0..1] : String&#10;Kompensationsmassnahme[1] : Kompensationsmassnahme</y:AttributeLabel>
                <y:MethodLabel textColor="#000000"></y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
        <node id="n4">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#04b889" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Projekt</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">Eingangsdatum[1] : XMLDate&#10;Projekt_Bemerkungen[0..1] : String&#10;Projektname[1] : String&#10;Projektstatus[1] : Projektstatus</y:AttributeLabel>
                <y:MethodLabel textColor="#000000">Constraint1()</y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
      </graph>
    </node>
    <!-- Namespace: <root> -->
    <node id="n5">
      <data key="d0">
        <y:UMLClassNode>
          <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
          <y:Fill color="#ff9933" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Kompensationsmassnahme</y:NodeLabel>
          <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="Enumeration" use3DEffect="false">
            <y:AttributeLabel textColor="#000000">Aufwertung&#10;Auszonung&#10;Sonstiges</y:AttributeLabel>
            <y:MethodLabel textColor="#000000"></y:MethodLabel>
          </y:UML>
        </y:UMLClassNode>
      </data>
    </node>
    <node id="n6">
      <data key="d0">
        <y:UMLClassNode>
          <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
          <y:Fill color="#ff9933" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Projektstatus</y:NodeLabel>
          <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="Enumeration" use3DEffect="false">
            <y:AttributeLabel textColor="#000000">geplant&#10;beschlossen_verfuegt&#10;laufend&#10;abgeschlossen</y:AttributeLabel>
            <y:MethodLabel textColor="#000000"></y:MethodLabel>
          </y:UML>
        </y:UMLClassNode>
      </data>
    </node>
    <edge id="e0" source="n4" target="n1">
      <data key="d1">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="none"/>
          <y:EdgeLabel alignment="center" configuration="AutoFlippingLabel" distance="2.0" fontFamily="Dialog" fontSize="11" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="two_pos" preferredPlacement="center" ratio="0.5" textColor="#000000" visible="true">1 ⟷ 0..* (Projekt_r–Beanspruchung_r)</y:EdgeLabel>
          <y:BendStyle smoothed="false"/>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e1" source="n4" target="n2">
      <data key="d1">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="none"/>
          <y:EdgeLabel alignment="center" configuration="AutoFlippingLabel" distance="2.0" fontFamily="Dialog" fontSize="11" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="two_pos" preferredPlacement="center" ratio="0.5" textColor="#000000" visible="true">0..* ⟷ 1 (Projekt_r–Gesuchsteller_r)</y:EdgeLabel>
          <y:BendStyle smoothed="false"/>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e2" source="n4" target="n3">
      <data key="d1">
        <y:PolyLineEdge>
          <y:Path sx="0.0" sy="0.0" tx="0.0" ty="0.0"/>
          <y:LineStyle color="#000000" type="line" width="1.0"/>
          <y:Arrows source="none" target="none"/>
          <y:EdgeLabel alignment="center" configuration="AutoFlippingLabel" distance="2.0" fontFamily="Dialog" fontSize="11" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="two_pos" preferredPlacement="center" ratio="0.5" textColor="#000000" visible="true">1 ⟷ 0..* (Projekt_r–Kompensation_r)</y:EdgeLabel>
          <y:BendStyle smoothed="false"/>
        </y:PolyLineEdge>
      </data>
    </edge>
  </graph>
</graphml>
