<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:y="http://www.yworks.com/xml/graphml"
         xmlns:yed="http://www.yworks.com/xml/yed/3"
         xmlns:java="http://www.yworks.com/xml/yfiles-common/1.0/java"
         xmlns:sys="http://www.yworks.com/xml/yfiles-common/markup/primitives/2"
         xmlns:x="http://www.yworks.com/xml/yfiles-common/markup/2.0">
  <key id="d0" for="node" yfiles.type="nodegraphics"/>
  <key id="d1" for="edge" yfiles.type="edgegraphics"/>
  <graph edgedefault="directed" id="G">
    <node id="n0" yfiles.foldertype="group">
      <data key="d0">
        <y:GroupNode>
          <y:Geometry height="400.0" width="400.0" x="0.0" y="0.0"/>
          <y:Fill color="#FFFFFF" transparent="false"/>
          <y:BorderStyle color="#000000" type="line" width="1.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="13" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" modelName="internal" modelPosition="t" visible="true">Kompensation</y:NodeLabel>
          <y:State closed="false"/>
          <y:Insets bottom="15" left="15" right="15" top="45"/>
        </y:GroupNode>
      </data>
      <graph edgedefault="directed" id="n0:">
        <node id="n1">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#04b889" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Flaechen</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">Firma_Adresse[0..1] : String&#10;Firma_Kontaktperson[0..1] : String&#10;Firma_Mail[0..1] : String&#10;Firma_Name[1] : String&#10;Firma_Telefon[0..1] : String&#10;Firma_UID[1] : String&#10;Flaeche_Art[1] : Flaechenart&#10;Flaeche_Bemerkungen[0..1] : String&#10;Flaeche_anrechenbar[0..1] : Numeric&#10;Flaeche_berechnet[0..1] : Numeric&#10;Geometrie[1] : AreaWithOverlaps2mm&#10;Projekt_Bemerkungen[0..1] : String&#10;Projekt_Eingangsdatum[1] : XMLDate&#10;Projekt_Projektname[1] : String&#10;Projekt_Status[1] : Projektstatus&#10;Projektflaechen[0..*] : Teilflaechen</y:AttributeLabel>
                <y:MethodLabel textColor="#000000"></y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
        <node id="n2">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#ffcc00" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Teilflaechen</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="Structure" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">Bezeichnung[0..1] : String&#10;Flaeche_anrechenbar[0..1] : Numeric&#10;Flaechenart[1] : Flaechenart&#10;Link[1] : String</y:AttributeLabel>
                <y:MethodLabel textColor="#000000"></y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
        <node id="n3">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#ff9933" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Flaechenart</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="Enumeration" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">Beanspruchung&#10;Aufwertung&#10;Auszonung&#10;Sonstiges</y:AttributeLabel>
                <y:MethodLabel textColor="#000000"></y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
        <node id="n4">
          <data key="d0">
            <y:UMLClassNode>
              <y:Geometry height="120.0" width="180.0" x="0.0" y="0.0"/>
              <y:Fill color="#ff9933" transparent="false"/>
              <y:BorderStyle color="#000000" type="line" width="1.0"/>
              <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" modelName="sandwich" modelPosition="n" textColor="#000000" visible="true">Projektstatus</y:NodeLabel>
              <y:UML clipContent="true" constraint="" omitDetails="false" stereotype="Enumeration" use3DEffect="false">
                <y:AttributeLabel textColor="#000000">geplant&#10;beschlossen_verfuegt&#10;laufend&#10;abgeschlossen</y:AttributeLabel>
                <y:MethodLabel textColor="#000000"></y:MethodLabel>
              </y:UML>
            </y:UMLClassNode>
          </data>
        </node>
      </graph>
    </node>
  </graph>
</graphml>
