INTERLIS 2.4;

/** !!------------------------------------------------------------------------------
 *  !! Version    | wer | Aenderung
 *  !!------------------------------------------------------------------------------
 *  !! 2026-07-15 | MS  | Erstversion 
 *  !!==============================================================================
 */
!!@ technicalContact=mailto:agi@bd.so.ch
MODEL SO_AFU_Grundwassereinbauten_20260715 (de)
AT "http://geo.so.ch/models/AFU"
VERSION "2026-07-15"  =
  IMPORTS GeometryCHLV95_V2;

  TOPIC Grundwassereinbauten =
    OID AS INTERLIS.UUIDOID;

    DOMAIN

      Status_Einbau_Enum = (
        !!@ ili2db.dispName = "Bewilligung erstellt"
        Bewilligung_erstellt,
        !!@ ili2db.dispName = "Bewilligung durch Behörde eröffnet"
        Bewilligung_durch_Baubehoerde_eroeffnet,
        !!@ ili2db.dispName = "Bewilligung wird nicht ausgeführt"
        Bewilligt_nicht_ausgefuehrt
      );

      Status_Abnahme_Enum = (
        !!@ ili2db.dispName = "keine Abnahme erforderlich"
        keine_Abnahme,
        !!@ ili2db.dispName = "pendent"
        pendent,
        !!@ ili2db.dispName = "abgenommen"
        abgenommen
      );

    /** Angaben zu den Grundwassereinbauten
     */
    CLASS Grundwassereinbau =
      /** Objektname.
       */
      Vorhaben : MANDATORY TEXT*300;
      /** Datum der Objektaufnahme.
       */
      Erfassungsdatum : MANDATORY INTERLIS.XMLDate;
      /** Geschäftsnummer BauGK, falls vorhanden.
       */
      BauGK_Nummer : TEXT*200;
      /** eBau-Nummer.
       */
      eBau_Nummer : TEXT*200;
      /** Räumliche Darstellung des Grundwassereinbaus als Punkt in LV95.
       */
      Geometrie : MANDATORY GeometryCHLV95_V2.Coord2;
      /** Aktennummer gemäss Registraturplan.
       */
      Aktennummer : TEXT*20;

      UNIQUE Aktennummer;
    END Grundwassereinbau;

    /** Voranfragen zu Einbauten ins Grundwasser
    */
    CLASS Voranfrage =
      /** Angaben zur Person, welche die Voranfrage stellte.
      */
      Anfrage_durch : MANDATORY MTEXT*200;
      /**Vorbesprechung ja oder nein
      */
      Vorbesprechung : BOOLEAN;
      /**Unterlagen zur Vorbesprechung 
      */
      Unterlagen : TEXT*200;
      /**Vorhabensbeschreibung 
      */
      Vorhabensbeschreibung : MANDATORY MTEXT*2000;
      /**Antworten 
      */
      Antworten : MANDATORY MTEXT*2000;
      /**Hydrogeologie 
      */
      Hydrogeologie : MTEXT*2000;
    END Voranfrage;

    /** Angaben zu Bewilligung, Bau und Abnahme.
     */
    CLASS Bewilligung =
      /** Datum der Bewilligung.
       */
      Bewilligungsdatum : INTERLIS.XMLDate;
      /** Datum der Eröffnung durch die Baubehörde.
       */
      Eroeffnung_Baubehoerde : INTERLIS.XMLDate;
      /** Art des Einbaus. Bodenplatte
       */
      Grundwassereinbau_Art_Bodenplatte : BOOLEAN;
      /** Art des Einbaus. Vertiefungen
       */
      Grundwassereinbau_Art_Vertiefungen : BOOLEAN;
      /** Art des Einbaus. Andere
       */
      Grundwassereinbau_Art_Andere : BOOLEAN;
      /** Art des Einbaus. Pfähle
       */
      Grundwassereinbau_Art_Pfaehle : BOOLEAN;
      /** Art des Einbaus. Temporäre Wasserhaltung
       */
      Grundwassereinbau_Art_Temporaere_Wasserhaltung : BOOLEAN;
      /** Bemerkung_Art_und_Formelles.
       */
      Bemerkung_Art : MTEXT*2000;
      /** Art der Wasserhaltung. Wellpoint
       */
      Wasserhaltung_Wellpoint : BOOLEAN;
      /** Art der Wasserhaltung. Pumpensumpf
       */
      Wasserhaltung_Pumpensumpf : BOOLEAN;
      /** Art der Wasserhaltung. Filterbrunnen
       */
      Wasserhaltung_Filterbrunnen : BOOLEAN;
      /** Art der Wasserhaltung. Andere
       */
      Wasserhaltung_Andere : BOOLEAN;      
      /** Kote des höchsten Grundwasserspiegels in Meter über Meer.
       */
      Kote_HGW : 0.0 .. 9999.9;
      /** Kote des mittleren Grundwasserspiegels in Meter über Meer.
       */
      Kote_MGW : 0.0 .. 9999.9;
      /** Kote des tiefsten Grundwasserspiegels in Meter über Meer.
       */
      Kote_TGW : 0.0 .. 9999.9;
      /** Kote des Stauers in Meter über Meer.
       */
      Kote_Stauer : 0.0 .. 9999.9;
      /** Kote der generellen Fundation, beispielsweise der Bodenplatte, in Meter über Meer.
       */
      Kote_generelle_Fundation : 0.00 .. 9999.99;
      /** Kote von Vertiefungen, beispielsweise einer Liftunterfahrt, in Meter über Meer.
       */
      Kote_Vertiefungen : 0.00 .. 9999.99;
      /** Kote der Pfahlfundation in Meter über Meer.
       */
      Kote_Pfahlfundation : 0.00 .. 9999.99;
      /** Kommentar zu den Koten (z.B. «Messung auf Parzelle», «mit Referenzmessstelle abgeglichen», «Angaben aus Untersuchungen auf GB Gde Nr. XXX» etc)
      */
      Kommentar_Koten : MTEXT*2000;
      /** Beanspruchtes Volumen unter dem mittleren Grundwasserspiegel in Kubikmetern.
       */
      Beanspruchtes_Volumen_unter_MGW : 0.00 .. 9999.99;
      /** Querschnittsverringerung unter dem mittleren Grundwasserspiegel in Prozent.
       */
      Querschnittsverringerung_unter_MGW : 0.00 .. 100.00;
      /** Kompensationsmassnahmen, beispielsweise Massnahmen zur Förderung des Durchflusses.
       */
      Kompensationsmassnahmen : MTEXT*2000;
      /** Lässt man das Pumpwasser versickern?
      */
      Rueckgabe_Versickerung : MANDATORY BOOLEAN;
      /** Rückgabe des Pumpwassers in Grundbuch / Gemeinde
      */
      Rueckgabe_Versickerung_Grundbuch_Name : TEXT*50;
      /** Rückgabe des Pumpwassers in Parzelle Grundbuchnummer
      */
      Rueckgabe_Versickerung_Grundstueck : TEXT*25;
      /** Leitet man das Pumpwasser in Gewässer ab?
      */
      Rueckgabe_Gewaesser : MANDATORY BOOLEAN;
      /** Name des Gewässers in das das Pumpwasser zurückgegeben wird.
      */
      Rueckgabe_Gewaesser_Gewaessername : TEXT*100;
      /** Menge des Pumpwassers, das ins Gewässer abgegeben wird in l/min. 
      */
      Rueckgabe_Gewaesser_Wassermenge : 0..9999;
      /** Wird das Pumpwasser in die Kanalisation geleitet? 
      */
      Rueckgabe_Kanalisation : MANDATORY BOOLEAN;
      /** ARA Name in welche das Pumpwasser abgegeben wird. 
      */
      Rueckgabe_Kanalisation_ARA_Name : TEXT*100; 
      /** Höchste Pumpmenge in Litern pro Minute.
       */
      Hoechste_Pumpmenge : 0 .. 99999;
      /** Mittlere Pumpmenge in Litern pro Minute.
       */
      Mittlere_Pumpmenge : 0 .. 99999;
      /** Voraussichtliche Pumpdauer in Wochen.
       */
      Voraussichtliche_Pumpdauer : 0.0 .. 99.9;
      /** Gesamte Pumpmenge in Kubikmetern.
       */
      Gesamte_Pumpmenge : 0 .. 99999999;
      /** Status der Bewilligung.
       */
      Status_Bewilligung : MANDATORY Status_Einbau_Enum;
      /** für die Abnahmen Zuständige Person oder Stelle.
       */
      Zustaendigkeit : MANDATORY TEXT*200;
      /** Status der Abnahme der Hinterfüllung. 
       */
      Abnahme_Hinterfuellung : MANDATORY Status_Abnahme_Enum;
      /** Datum der Abnahme der Hinterfüllung. 
       */
      Abnahme_Hinterfuellung_Datum : INTERLIS.XMLDate;
      /** Status der Abnahme der Ersatzmassnahmen.
       */
      Abnahme_Ersatzmassnahmen : MANDATORY Status_Abnahme_Enum;
      /** Datum der Abnahme der Ersatzmassnahmen.
       */
      Abnahme_Ersatzmassnahmen_Datum : INTERLIS.XMLDate;      
      /** Status der Schadstoffanalyse vor Pumpbeginn.
       */
      Schadstoffanalyse_vor_Pumpbeginn : MANDATORY Status_Abnahme_Enum;
      /** Datum der Schadstoffanalyse vor Pumpbeginn.
       */
      Schadstoffanalyse_vor_Pumpbeginn_Datum : INTERLIS.XMLDate;
      /** Status der Abnahme des Pumpprotokolls.
       */
      Abnahme_Pumpprotokoll : MANDATORY Status_Abnahme_Enum;
      /** Datum der Abnahme des Pumpprotokolls.
       */
      Abnahme_Pumpprotokoll_Datum : INTERLIS.XMLDate;
      /** Status der Abnahme der Pfähle.
       */
      Abnahme_Pfaehle : MANDATORY Status_Abnahme_Enum;
      /** Datum der Abnahme der Pfähle.
       */
      Abnahme_Pfaehle_Datum : INTERLIS.XMLDate;
      /** Status des Monitorings.
       */
      Monitoring : MANDATORY Status_Abnahme_Enum;
      /** Datum des Monitorings.
       */
      Monitoring_Datum : INTERLIS.XMLDate;
      /** Kommentare und Beanstandungen im Zusammenhang mit den Abnahmen.
       */
      Kommentar_Beanstandungen : MTEXT*2000;

      !!@ name = "Abnahme_Hinterfuellung_Datum"
      !!@ ilivalid.msg = "Wenn die Hinterfüllung abgenommen wurde (und nur dann) darf ein Abnahmedatum gesetzt werden."  
      MANDATORY CONSTRAINT
        Abnahme_Hinterfuellung != #abgenommen OR
        DEFINED(Abnahme_Hinterfuellung_Datum);

      !!@ name = "Abnahme_Ersatzmassnahmen_Datum"
      !!@ ilivalid.msg = "Wenn die Ersatzmassnahmen abgenommen wurden (und nur dann), muss ein Abnahmedatum gesetzt sein."
      MANDATORY CONSTRAINT
        Abnahme_Ersatzmassnahmen != #abgenommen OR
        DEFINED(Abnahme_Ersatzmassnahmen_Datum);

      !!@ name = "Schadstoffanalyse_vor_Pumpbeginn_Datum"
      !!@ ilivalid.msg = "Wenn die Schadstoffanalyse vor Pumpbeginn abgenommen wurde (und nur dann), muss ein Datum gesetzt sein."
      MANDATORY CONSTRAINT
        Schadstoffanalyse_vor_Pumpbeginn != #abgenommen OR
        DEFINED(Schadstoffanalyse_vor_Pumpbeginn_Datum);

      !!@ name = "Abnahme_Pumpprotokoll_Datum"
      !!@ ilivalid.msg = "Wenn das Pumpprotokoll abgenommen wurde (und nur dann), muss ein Abnahmedatum gesetzt sein."
      MANDATORY CONSTRAINT
        Abnahme_Pumpprotokoll != #abgenommen OR
        DEFINED(Abnahme_Pumpprotokoll_Datum);

      !!@ name = "Abnahme_Pfaehle_Datum"
      !!@ ilivalid.msg = "Wenn die Pfähle abgenommen wurden (und nur dann), muss ein Abnahmedatum gesetzt sein."
      MANDATORY CONSTRAINT
        Abnahme_Pfaehle != #abgenommen OR
        DEFINED(Abnahme_Pfaehle_Datum);

      !!@ name = "Monitoring_Datum"
      !!@ ilivalid.msg = "Wenn das Monitoring abgenommen wurde (und nur dann), muss ein Datum gesetzt sein."
      MANDATORY CONSTRAINT
        Monitoring != #abgenommen OR
        DEFINED(Monitoring_Datum);

      !!@ name = "Rueckgabe_Grundstueck"
      !!@ ilivalid.msg = "Wenn Rückgabe Versickerung gewählt wurde, muss eine Parzellen-Nummer angegeben werden."
      MANDATORY CONSTRAINT
        Rueckgabe_Versickerung == #false OR
        DEFINED(Rueckgabe_Versickerung_Grundstueck);

      !!@ name = "Rueckgabe_Gewaesser"
      !!@ ilivalid.msg = "Wenn Rückgabe Gewässer gewählt wurde, muss ein Gewässername angegeben werden."
      MANDATORY CONSTRAINT
        Rueckgabe_Gewaesser == #false OR
        DEFINED(Rueckgabe_Gewaesser_Gewaessername);

      !!@ name = "Rueckgabe_Kanalisation"
      !!@ ilivalid.msg = "Wenn Rückgabe Kanalisation gewählt wurde, muss ein ARA-Name angegeben werden."
      MANDATORY CONSTRAINT
        Rueckgabe_Kanalisation == #false OR
        DEFINED(Rueckgabe_Kanalisation_ARA_Name);

      !!@ name = "Vertiefung_und_Kote_Bauprojektn"
      !!@ ilivalid.msg = "Wenn Einbau Art Vertiefungen ausgewählt ist, ist unter Koten Bauprojekt die Kote Vertiefungen Pflicht."
      MANDATORY CONSTRAINT
        Grundwassereinbau_Art_Vertiefungen == #false OR
        DEFINED(Kote_Vertiefungen);

      !!@ name = "Pfaehle_und_Kote_Pfaehlung"
      !!@ ilivalid.msg = "Wenn Einbau Art Pfähle ausgewählt ist, ist unter Koten Bauprojekt die Kote Pfählung Pflicht."
      MANDATORY CONSTRAINT
        Grundwassereinbau_Art_Pfaehle == #false OR
        DEFINED(Kote_Pfahlfundation);

      !!@ name = "Fundament_Vertiefung_Pfaehle_Andere"
      !!@ ilivalid.msg = "Wenn unter Einbau Art entweder Fundament, Vertiefungen, Pfähle oder Andere ausgewählt ist, muss Beanspruchtes Volumen unter MGW und Querschnittsverringerung unter MGW ausgefüllt sein."
      MANDATORY CONSTRAINT
        (Grundwassereinbau_Art_Bodenplatte != #false OR 
         Grundwassereinbau_Art_Vertiefungen != #false OR 
         Grundwassereinbau_Art_Pfaehle != #false OR 
         Grundwassereinbau_Art_Andere != #false) =>          
        (DEFINED(Beanspruchtes_Volumen_unter_MGW) OR 
         DEFINED(Querschnittsverringerung_unter_MGW)
        );

      !!@ name = "Obligatorische_Attribute_wenn_Bewilligung_durch_Baubehoerden_eroeffnet"
      !!@ ilivalid.msg = "Wenn die Bewilligung durch Baubehörden eröffnet wurde, muss das Datum der eröffnung angegeben werden."
      MANDATORY CONSTRAINT 
        Status_Bewilligung != #Bewilligung_durch_Baubehoerde_eroeffnet OR 
        DEFINED(Eroeffnung_Baubehoerde);

      !!@ name = "Obligatorische_Attribute_bei_Temporaerer_Wasserhaltung."
      !!@ ilivalid.msg = "Wenn temporäre Wasserhaltung, müssen Pumpmengen, Dauer, Art der Wasserhaltung und Rückgabe ausgefüllt bzw. gewählt werden."
      MANDATORY CONSTRAINT
        (Grundwassereinbau_Art_Temporaere_Wasserhaltung != #false) =>
        (DEFINED(Hoechste_Pumpmenge) AND
         DEFINED(Mittlere_Pumpmenge) AND 
         DEFINED(Voraussichtliche_Pumpdauer) AND 
         DEFINED(Gesamte_Pumpmenge) AND (
          (Wasserhaltung_Wellpoint == #true) OR 
          (Wasserhaltung_Pumpensumpf == #true) OR 
          (Wasserhaltung_Filterbrunnen == #true) OR 
          (Wasserhaltung_Andere == #true) 
         ) AND (
          (Rueckgabe_Versickerung == #true) OR 
          (Rueckgabe_Gewaesser == #true) OR 
          (Rueckgabe_Kanalisation == #true)
         )
        );

    END Bewilligung;

    /**Grundwassereinbauten können 0 bis n Bewilligung haben. Wenn eine Bewilligung erstellt werden, müssen diverse Bedingungen erfüllt sein.
    */
    ASSOCIATION Grundwassereinbau_Bewilligung =
      Bewilligung_r -- {0..*} Bewilligung;
      Grundwassereinbau_r -- {1} Grundwassereinbau;

      !!@ name = "Obligatorische_Attribute_wenn_Bewilligung_erstellt"
      !!@ ilivalid.msg = "Wenn die Bewilligung erstellt wurde, müssen die obligatorischen Angaben ausgefüllt sein."
      MANDATORY CONSTRAINT
        Bewilligung_r->Status_Bewilligung == #Bewilligung_erstellt =>
        (
          DEFINED(Grundwassereinbau_r->Aktennummer) AND
          DEFINED(Grundwassereinbau_r->Vorhaben) AND
          DEFINED(Bewilligung_r->Bewilligungsdatum) AND
          (
            Bewilligung_r->Grundwassereinbau_Art_Bodenplatte == #true OR
            Bewilligung_r->Grundwassereinbau_Art_Vertiefungen == #true OR
            Bewilligung_r->Grundwassereinbau_Art_Andere == #true OR
            Bewilligung_r->Grundwassereinbau_Art_Pfaehle == #true OR
            Bewilligung_r->Grundwassereinbau_Art_Temporaere_Wasserhaltung == #true
          ) AND
          DEFINED(Bewilligung_r->Kote_generelle_Fundation) AND
          DEFINED(Bewilligung_r->Kote_HGW) AND
          DEFINED(Bewilligung_r->Kote_MGW) AND
          DEFINED(Bewilligung_r->Kote_TGW) AND
          DEFINED(Bewilligung_r->Kote_Stauer) AND
          DEFINED(Bewilligung_r->Kommentar_Koten)
        );
    END Grundwassereinbau_Bewilligung;

    /**Grundwassereinbauten können eine Voranfrage haben, müssen aber nicht.
    */
    ASSOCIATION Grundwassereinbau_Voranfrage =
      Voranfrage_r -- {0..1} Voranfrage;
      Grundwassereinbau_r -- {1} Grundwassereinbau; 
    END Grundwassereinbau_Voranfrage;

  END Grundwassereinbauten;

END SO_AFU_Grundwassereinbauten_20260715.