INTERLIS 2.4;

/** Hilfsmodell zur Zuweisung der alten Berichte zu den entsprechenden Gemeinden.
 * !!------------------------------------------------------------------------------
 * !! Version    | wer | Aenderung
 * !!------------------------------------------------------------------------------
 * !! 2026-08-19 | Jek | Ersterfassung
 * !!==============================================================================
 */
!!@ technicalContact=mailto:agi@so.ch
MODEL SO_AFU_Naturgefahren_alte_Dokumente_20260819 (de)
  AT "https://afu.so.ch"
  VERSION "2026-08-19"
  =
  IMPORTS GeometryCHLV95_V2;

  TOPIC Main =
    OID AS INTERLIS.UUIDOID;

    CLASS Alte_Dokumente =
      /** Name der Datei des Berichts in der Ablage.
       * Bsp: 119_Seewen_Sturz_Gauggema_2020.pdf
       */
      Dateiname : MANDATORY TEXT*255;
      /** Erstellungsjahr des Berichts.
       */
      Jahr : MANDATORY TEXT*20;
      /** Titel des Berichts.
       * Bsp: "Gefahrenbeurteilung Sturz Seewen"
       */
      Titel : MANDATORY TEXT*255;
      /**Hilfspunkte. Mit ihnen wird über ein Spatial Query ein Bericht auf Gemeinden zugewiesen,*/
      Geometrie : MANDATORY GeometryCHLV95_V2.MultiPoint;
    END Alte_Dokumente;

  END Main;

END SO_AFU_Naturgefahren_alte_Dokumente_20260819.
