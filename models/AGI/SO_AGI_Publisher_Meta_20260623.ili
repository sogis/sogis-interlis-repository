INTERLIS 2.4;

/** Model of the GRETL Publisher Tasks metainformation (publishdate, ...)
 * !!------------------------------------------------------------------------------
 * !! Version    | wer | Änderung
 * !!------------------------------------------------------------------------------
 * !! 2026-06-23 | jek | Initiale Erstellung
 * !!==============================================================================
 */
!!@ shortDescription="Model of the GRETL Publisher Tasks metainformation (publishdate, ...)"
!!@ title="Publisher metadata model"
!!@ technicalContact=agi@bd.so.ch
MODEL SO_AGI_Publisher_Meta_20260623 (de)
  AT "https://geo.so.ch/models/AGI"
  VERSION "2026-03-24"
  =
  IMPORTS GeometryCHLV95_V2;

  TOPIC Publisher =

    /** Result of one run of the publisher task.
     */
    CLASS PublicationRun =
      /** Identifier of the themepublication
       */
      DataIdent : MANDATORY TEXT*256;
      /** Date of the run
       */
      PubDate : MANDATORY DATE;
      UNIQUE DataIdent, PubDate;
    END PublicationRun;

    /** If a run publishes the data split up in several fragments,
     * these are recorded here.
     * The publisher integrates previously generated fragments as
     * convenience for the downloader into one zip.
     * Here reflected are only those fragments, that where newly
     * generated from source by this run.
     * A run of a configuration with non splitted data does have no records
     * in this class.
     */
    CLASS Part =
      /** Identifier of the Fragments that where generated form source by this run
       */
      PartIdent : MANDATORY TEXT*256;
    END Part;

    ASSOCIATION Publication_Part =
      Publication_R -- {1} SO_AGI_Publisher_Meta_20260623.Publisher.PublicationRun;
      Part_R -- {0..*} SO_AGI_Publisher_Meta_20260623.Publisher.Part;
      UNIQUE Publication_R, Part_R->PartIdent;
    END Publication_Part;

    /** One of the 1-n exported formats of the run,
     * as defined by Publisher.outFormats.
     */
    CLASS ExportedFormat =
      Format : MANDATORY (
        xtf,
        itf,
        gpkg,
        shp,
        dxf,
        dxf_geobau
      );
    END ExportedFormat;

    ASSOCIATION Publication_ExportedFormat =
      Publication_R -- {1} SO_AGI_Publisher_Meta_20260623.Publisher.PublicationRun;
      Format_R -- {1..*} SO_AGI_Publisher_Meta_20260623.Publisher.ExportedFormat;
      UNIQUE Publication_R, Format_R->Format;
    END Publication_ExportedFormat;

  END Publisher;

END SO_AGI_Publisher_Meta_20260623.
