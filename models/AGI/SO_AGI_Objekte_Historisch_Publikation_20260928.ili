INTERLIS 2.4;

/** !!------------------------------------------------------------------------------
 * !! Version    | wer | Änderung
 * !!------------------------------------------------------------------------------
 * !! 2026-09-28 | pb  | Erstfassung
 * !!==============================================================================
 */
!!@ shortDescription="Reduziertes Publikatonsmodell für historisierte Gebäude- und Strassendaten"
!!@ title=SO_AGI_Gebauede_Strassen_Historisch_Publikation_20260928
!!@ technicalContact=agi@bd.so.ch
MODEL SO_AGI_Objekte_Historisch_Publikation_20260928 (de)
  AT "http://www.geo.so.ch/models/AVT"
  VERSION "2026-09-29"
  =
  IMPORTS GeometryCHLV95_V2, CHAdminCodes_V2;

  TOPIC Objekte =
    OID AS INTERLIS.UUIDOID;

    CLASS Bodenbedeckung =
      /** Bodenbedeckungsart (Text-Repräsentation)
       */
      Art_txt : MANDATORY TEXT*100;
      /** Gemeindenummer (BfS-Nummer) der Gemeinde in welcher das Objekt liegt.
       */
      BFS_Nr : MANDATORY CHAdminCodes_V2.CHMunicipalityCode;
      /** Eidgenössischer Gebäudeidentifikator
       */
      EGID : 0 .. 999999999;
      /** Exportdatum der Daten aus Mopubic
       */
      Datenexport : MANDATORY DATETIME;
      /** Datum der Nachführung durch Geometer
       */
      Nachfuehrung : DATE;
      /** Geometrie
       */
      Geometrie : MANDATORY GeometryCHLV95_V2.Surface;
    END Bodenbedeckung;

    CLASS Einzelobjekt_Flaeche =
      /** Einzelobjektart (Text-Repräsentation)
       */
      Art_txt : MANDATORY TEXT*100;
      /** Gemeindenummer (BfS-Nummer) der Gemeinde in welcher das Objekt liegt.
       */
      BFS_Nr : MANDATORY CHAdminCodes_V2.CHMunicipalityCode;
      /** Eidgenössischer Gebäudeidentifikator
       */
      EGID : 0 .. 999999999;
      /** Exportdatum der Daten aus Mopubic
       */
      Datenexport : MANDATORY DATETIME;
      /** Datum der Nachführung durch Geometer
       */
      Nachfuehrung : DATE;
      /** Geometrie
       */
      Geometrie : MANDATORY GeometryCHLV95_V2.Surface;
    END Einzelobjekt_Flaeche;

  END Objekte;

END SO_AGI_Objekte_Historisch_Publikation_20260928.
